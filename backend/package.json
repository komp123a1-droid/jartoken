{
  "name": "swearjar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "$JAR — the swear jar: swear bot, sinner ledger, midnight collection, public API",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/index.js",
    "collect": "node --no-warnings --env-file-if-exists=.env scripts/collect-now.js",
    "test": "node --no-warnings scripts/selftest.js",
    "simulate": "node --no-warnings scripts/simulate-day.js",
    "tg": "node --no-warnings --env-file-if-exists=.env scripts/tg.js",
    "x": "node --no-warnings --env-file-if-exists=.env scripts/x.js",
    "import-key": "node --no-warnings scripts/import-key.js",
    "devnet": "node --no-warnings scripts/devnet-test.js",
    "test:all": "npm test && npm run simulate && node --no-warnings scripts/devnet-test.js offline",
    "localnet": "node --no-warnings scripts/localnet-e2e.js",
    "pump-test": "node --no-warnings scripts/pump-e2e.js",
    "test:chain": "npm run localnet && npm run pump-test",
    "pump-validator": "node --no-warnings scripts/pump-validator.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "@pump-fun/pump-sdk": "2.0.0",
    "@pump-fun/pump-swap-sdk": "1.20.0",
    "@solana/spl-token": "0.4.9"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  }
}
