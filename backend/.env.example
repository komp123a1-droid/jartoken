# mock = fake trades + fake holders (no keys needed). live = real chain via Helius.
MODE=mock
PORT=8788

# --- chain (live) ---
HELIUS_API_KEY=
# RPC_URL=            # optional; defaults to Helius mainnet when HELIUS_API_KEY is set
MINT=                 # $JAR CA — [coming soon]
DECIMALS=6            # pump.fun tokens use 6
# Path to the jar wallet keypair JSON (solana-keygen format). This wallet receives
# the creator fees and sends the payouts. HOT WALLET: keep only about one day of fees in it.
PAYOUT_KEYPAIR=
# Never paid, never counted as swearing: bonding curve, pool, dev, burn (comma separated)
EXCLUDED_WALLETS=

# --- rules ---
THRESHOLD_TOKENS=100000
PAYOUT_EVERY_MIN=15   # a drop every 15 min (UTC :00/:15/:30/:45). 1440 = once a day at 00:00 UTC
SIN_WINDOW_HOURS=24   # a sell or transfer-out = no drops for this many hours + unpaid balance forfeited
MIN_PAYOUT_SOL=0.001  # smaller shares add up in the wallet's balance and are sent once they reach this
RESERVE_SOL=0.02      # left in the jar for tx fees
BATCH_SIZE=18         # transfers per transaction
DRY_RUN=true          # true = compute + record, send nothing. Set false only when ready.
CLAIM_FEES=true       # claim pump.fun creator fees (bonding curve + PumpSwap vault) into the jar right before each collection.
                      # Official @pump-fun/pump-sdk; tested on the real programs cloned from mainnet (npm run pump-test).

# --- webhook ---
WEBHOOK_SECRET=       # put the same value in Helius "Authorization header"

# --- swear bot (README: "Telegram" i "X") ---
TG_BOT_TOKEN=         # from @BotFather
TG_CHAT_ID=           # -100… for a channel/group, or @publicchannel. Find it: npm run tg
# X: developer portal → app → "Keys and tokens". Set app permissions to Read and Write BEFORE generating the access token.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_MAX_PER_HOUR=4
X_MAX_PER_DAY=15      # X free tier allows few posts per month; check your current limit
X_MIN_TOKENS=1000000  # only sells this big are read aloud on X; Telegram gets all of them
X_DROP_POST_EVERY_H=6 # drop summary on X at most every N hours (Telegram gets every drop)
BOT_IN_MOCK=false     # true = post FAKE mock swears to the real accounts (only to test the bot)

# --- misc ---
# DB_PATH=./jar.db    # default: jar.db in live, jar-mock.db in mock
CORS_ORIGIN=*
MOCK_TRADE_MS=7000
BACKFILL_MIN=10       # live: re-pull missed trades from Helius history every N min (PC was off / internet down). 0 = off
